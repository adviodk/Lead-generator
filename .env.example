# Copy to .env and fill in. .env is git-ignored and stays in this folder only.

# --- LLM for ScrapeGraphAI: configure ONE provider ---
# Auto-picked if LLM_PROVIDER is blank: gemini > openai > anthropic > ollama
#LLM_PROVIDER=

# Google Gemini  (free tier, no credit card: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ollama  (fully local & free; needs Ollama running + a pulled model)
#   brew install ollama  ->  ollama serve  ->  ollama pull llama3.1
#OLLAMA_MODEL=llama3.1
#OLLAMA_MODEL_TOKENS=8192
#OLLAMA_BASE_URL=http://localhost:11434

# OpenAI  (paid)
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

# Anthropic  (paid)
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Sheets output (OAuth Desktop App) ---
# Put the downloaded OAuth client file in the project root as credentials.json.
# token.json is created on first sign-in and refreshed automatically.
#GOOGLE_OAUTH_CREDENTIALS=credentials.json
#GOOGLE_OAUTH_TOKEN=token.json
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Leads

# --- CVR distribution API (system-til-system, se EMAIL_TIL_ERST.md) ---
CVR_USERNAME=
CVR_PASSWORD=

# --- Google Places API (New) — se pris i chat; kræver billing on + Places API (New) enabled ---
GOOGLE_MAPS_API_KEY=
# Hårdt månedsloft for Places-kald på tværs af places_enrich.py / places_pull.py
# (fri kvote hos Google er 5000/md). CLI --monthly-cap vinder over denne.
# PLACES_MONTHLY_CAP=4500
